---
import { GITHUB_ORG } from '../data/modules';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}/`;
const nav = [
  ['Parts', 'parts'],
  ['One shape', 'shape'],
  ['Wiring', 'wiring'],
  ['Quickstart', 'quickstart'],
  ['Compare', 'compare'],
] as const;
---

<header class="top">
  <div class="wrap top__inner">
    <a class="brand" href={home}>
      <svg class="brand__mark" viewBox="0 0 32 32" width="32" height="32" aria-hidden="true">
        <rect x="1" y="1" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2"></rect>
        <rect x="7" y="7" width="18" height="5" fill="currentColor"></rect>
        <rect x="7" y="14" width="18" height="5" fill="var(--signal)"></rect>
        <rect x="7" y="21" width="18" height="4" fill="currentColor"></rect>
      </svg>
      <span class="brand__name">ShipStack <span class="brand__ai">AI</span></span><span class="visually-hidden">, home</span>
    </a>
    <nav aria-label="Sections">
      <ul class="nav">
        {nav.map(([label, id]) => <li><a href={`${home}#${id}`}>{label}</a></li>)}
      </ul>
    </nav>
    <div class="top__tools">
      <a class="tool tool--gh" href={GITHUB_ORG} rel="noopener">GitHub</a>
      <button class="tool theme-toggle" type="button" aria-label="Switch to dark blueprint mode" hidden>
        <span class="theme-toggle__icon" aria-hidden="true"></span>
        <span class="theme-toggle__text">Blueprint</span>
      </button>
      <details class="menu">
        <summary class="tool menu__btn">
          <span class="menu__icon" aria-hidden="true"></span>
          Menu
        </summary>
        <nav class="menu__panel" aria-label="Sections">
          <ol>
            {
              nav.map(([label, id], i) => (
                <li>
                  <a href={`${home}#${id}`}>
                    <span class="menu__no">§{String(i + 1).padStart(2, '0')}</span>
                    {label}
                  </a>
                </li>
              ))
            }
            <li>
              <a href={GITHUB_ORG} rel="noopener">
                <span class="menu__no">↗</span>GitHub
              </a>
            </li>
          </ol>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Mobile menu is a native <details>; JS only closes it after a jump or on Escape.
  const menu = document.querySelector<HTMLDetailsElement>('.menu');
  if (menu) {
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) menu.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }

  const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
  if (btn) {
    const root = document.documentElement;
    const sync = () => {
      const dark = root.dataset.theme === 'dark';
      btn.setAttribute('aria-label', dark ? 'Switch to paper (light) mode' : 'Switch to blueprint (dark) mode');
      btn.querySelector('.theme-toggle__text')!.textContent = dark ? 'Paper' : 'Blueprint';
    };
    btn.hidden = false;
    sync();
    btn.addEventListener('click', () => {
      root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
      try {
        localStorage.setItem('theme', root.dataset.theme);
      } catch {}
      sync();
    });
  }
</script>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: saturate(1.2) blur(6px);
    border-bottom: 1px solid var(--line-strong);
  }
  .top__inner {
    display: flex;
    align-items: center;
    gap: var(--s3);
    min-height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ink);
  }
  .brand__mark {
    flex: none;
  }
  .brand__name {
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: -0.02em;
  }
  .brand__ai {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    padding: 1px 4px;
    border: 1px solid currentColor;
    vertical-align: 3px;
  }
  .nav {
    display: flex;
    gap: var(--s3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav a,
  .tool {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--ink-2);
    text-decoration: none;
  }
  .nav a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  nav:not(.menu__panel) {
    margin-left: auto;
  }
  .top__tools {
    display: flex;
    align-items: center;
    gap: var(--s2);
  }
  .tool {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 12px;
    border: 1px solid var(--line-strong);
    background: transparent;
    cursor: pointer;
  }
  .tool:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
  .theme-toggle__icon {
    width: 12px;
    height: 12px;
    border: 1.5px solid currentColor;
    background: linear-gradient(135deg, currentColor 50%, transparent 50%);
  }
  .menu {
    display: none;
    position: relative;
  }
  .menu__btn {
    list-style: none;
  }
  .menu__btn::-webkit-details-marker {
    display: none;
  }
  .menu__icon {
    width: 14px;
    height: 10px;
    border-block: 1.5px solid currentColor;
    background: linear-gradient(currentColor, currentColor) center / 100% 1.5px no-repeat;
  }
  .menu[open] .menu__btn {
    color: var(--ink);
    border-color: var(--ink);
    background: var(--paper-2);
  }
  .menu__panel {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    width: min(280px, calc(100vw - 32px));
    margin: 0;
    background: var(--paper);
    border: 1.5px solid var(--ink);
    box-shadow: 4px 4px 0 var(--shadow);
  }
  .menu__panel ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .menu__panel a {
    display: flex;
    align-items: center;
    gap: var(--s2);
    min-height: 48px;
    padding: 0 var(--s2);
    border-bottom: 1px solid var(--line);
    font-weight: 600;
    font-size: 1.0625rem;
    text-decoration: none;
    color: var(--ink);
  }
  .menu__panel li:last-child a {
    border-bottom: 0;
  }
  .menu__panel a:hover {
    background: var(--paper-2);
  }
  .menu__no {
    width: 3ch;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--signal-ink);
  }
  @media (max-width: 900px) {
    nav:not(.menu__panel) {
      display: none;
    }
    .top__tools {
      margin-left: auto;
    }
    .menu {
      display: block;
    }
    .tool--gh {
      display: none;
    }
  }
  @media (max-width: 420px) {
    .theme-toggle__text {
      display: none;
    }
  }
</style>
