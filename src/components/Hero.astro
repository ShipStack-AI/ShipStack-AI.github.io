---
import { GITHUB_ORG, modules } from '../data/modules';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const built = modules.filter((m) => m.status === 'built');
// The one part that installs with no peers and works in three lines.
const featured = modules.find((m) => m.slug === 'rate-limit') ?? modules[0]!;
const install = `pnpm add ${featured.pkg}`;
// From the phase-0 contract: types each part consumes, duplicated on purpose instead of a shared package.
const pins: [string, string][] = [
  ['Principal', 'auth → rbac'],
  ['RateLimiterLike', 'rate-limit → auth'],
  ['QueueLike', 'jobs → notifications, webhooks'],
  ['EventSink', 'every part → your app'],
];
const rows: [string, string][] = [
  ['Parts in catalog', `${modules.length}`],
  ['Built', `${built.length} of ${modules.length}`],
  ['In progress', `${modules.length - built.length}`],
  ['License', 'MIT'],
  ['Language', 'TypeScript, ESM only'],
  ['Runtime', 'Node >= 22, Web APIs'],
  ['Core runtime deps', '0'],
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero__grid">
    <div class="hero__main">
      <p class="label hero__kicker">
        <span class="label--ink">ShipStack AI</span> / Catalog of backend parts for TypeScript
      </p>

      <div class="dim" aria-hidden="true">
        <span class="dim__tick"></span>
        <span class="dim__line"></span>
        <span class="dim__text">{modules.length} parts · 1 shape</span>
        <span class="dim__line"></span>
        <span class="dim__tick"></span>
      </div>

      <h1 id="hero-title" class="hero__title">
        <span>Parts,</span>
        <span>not platforms<span class="dot">.</span></span>
      </h1>

      <p class="hero__sub">
        Production-ready backend modules for TypeScript. Install one. Swap any adapter. Own your tables.
      </p>

      <div class="install">
        <span class="install__prompt" aria-hidden="true">$</span>
        <code class="install__cmd">{install}</code>
        <button class="copy" type="button" data-copy={install} aria-label="Copy install command">Copy</button>
      </div>
      <p class="install__note mono">
        Not on npm yet. The first publish happens at 0.1.0; until then, install from the
        <a href={`${GITHUB_ORG}/${featured.repo}`}>{featured.name} repo</a>.
      </p>

      <div class="hero__cta">
        <a class="btn btn--signal" href="#parts">Browse the parts <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn" href={GITHUB_ORG} rel="noopener">Star on GitHub</a>
      </div>
    </div>

    <aside class="plate crop" aria-label="Catalog specification">
      <div class="plate__head">
        <span class="label label--ink">Spec sheet</span>
        <span class="label">Cat. SS-00</span>
      </div>
      <nav class="binmap" aria-label="Bin map: jump to a part's datasheet">
        <ol role="list">
          {
            modules.map((m) => (
              <li>
                <a class:list={['binmap__cell', `binmap__cell--${m.status}`]} href={`${base}/modules/${m.slug}/`}>
                  <span class="binmap__no">{m.part.replace('SS-', '')}</span>
                  <span class="binmap__name">{m.name}</span>
                </a>
              </li>
            ))
          }
        </ol>
        {
          built.length < modules.length && (
            <p class="binmap__key label">
              <span class="key key--built" />built <span class="key key--wip" />in progress
            </p>
          )
        }
      </nav>
      <dl class="plate__rows">
        {
          rows.map(([k, v]) => (
            <div class="plate__row">
              <dt class="label">{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
      <div class="pinout">
        <span class="label label--ink">Pinout · shared structural types</span>
        <dl>
          {
            pins.map(([t, who]) => (
              <div>
                <dt>{t}</dt>
                <dd>{who}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div class="plate__shape">
        <span class="label">Every part</span>
        <code>create&lt;Part&gt;(&#123; adapter &#125;)</code>
      </div>
      <div class="plate__barcode" aria-hidden="true"></div>
    </aside>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--s10) var(--s12);
    overflow: hidden;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: var(--s8);
    align-items: stretch;
  }
  .hero__kicker {
    margin-bottom: var(--s5);
  }
  .dim {
    display: flex;
    align-items: center;
    gap: var(--s1);
    max-width: 640px;
    margin-bottom: var(--s2);
    color: var(--blue);
  }
  .dim__tick {
    width: 1px;
    height: 16px;
    background: currentColor;
  }
  .dim__line {
    flex: 1;
    height: 1px;
    background: currentColor;
    position: relative;
  }
  .dim__line:first-of-type::before,
  .dim__line:last-of-type::after {
    content: '';
    position: absolute;
    top: -3px;
    border: 3.5px solid transparent;
  }
  .dim__line:first-of-type::before {
    left: 0;
    border-right-color: currentColor;
    border-left-width: 0;
  }
  .dim__line:last-of-type::after {
    right: 0;
    border-left-color: currentColor;
    border-right-width: 0;
  }
  .dim__text {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .hero__title {
    display: flex;
    flex-direction: column;
    font-size: clamp(3.5rem, 11.2vw, 10.5rem);
    line-height: 0.86;
    letter-spacing: -0.055em;
    margin-left: -0.05em;
  }
  .dot {
    color: var(--signal);
  }
  .hero__sub {
    margin-top: var(--s5);
    max-width: 34ch;
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    line-height: 1.33;
    color: var(--ink-2);
  }
  .install {
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: 560px;
    margin-top: var(--s5);
    padding: 8px 8px 8px var(--s2);
    border: 1.5px solid var(--ink);
    background: var(--paper-2);
  }
  .install__prompt {
    font-family: var(--font-mono);
    color: var(--signal-ink);
    font-weight: 700;
  }
  .install__cmd {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
    font-size: 0.9375rem;
  }
  .install__note {
    max-width: 560px;
    margin-top: var(--s1);
    font-size: 0.75rem;
    color: var(--ink-3);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    margin-top: var(--s4);
  }

  .plate {
    display: flex;
    flex-direction: column;
    gap: var(--s2);
    align-self: stretch;
    padding: var(--s3);
    background-color: var(--paper);
    border: 1px solid var(--line-strong);
    outline: 1px solid var(--line);
    outline-offset: 6px;
  }
  .plate__head {
    display: flex;
    justify-content: space-between;
    padding-bottom: var(--s1);
    border-bottom: 2px solid var(--ink);
  }
  .plate__rows {
    margin: 0;
  }
  .binmap ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .binmap__cell {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 36px;
    padding: 0 10px;
    border: 1px dashed var(--ink-3);
    text-decoration: none;
    color: var(--ink-2);
    transition: transform 160ms var(--ease), box-shadow 160ms var(--ease);
  }
  .binmap__cell:hover {
    color: var(--ink);
    transform: translateY(-2px);
    box-shadow: 0 2px 0 var(--shadow);
  }
  .binmap__cell--built {
    border: 1px solid var(--ink);
    color: var(--ink);
  }
  .binmap__cell--built .binmap__no {
    color: var(--signal-ink);
  }
  .binmap__cell--built:hover {
    background: var(--signal);
    border-color: var(--signal);
    color: var(--on-signal);
  }
  .binmap__cell--built:hover .binmap__no {
    color: var(--on-signal);
  }
  .binmap__no {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
  }
  .binmap__name {
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .binmap__key {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: var(--s1);
    font-size: 0.6875rem;
  }
  .key {
    width: 10px;
    height: 10px;
  }
  .key--built {
    border: 1px solid var(--ink);
  }
  .key--wip {
    margin-left: var(--s1);
    border: 1px dashed var(--ink-3);
  }
  .plate__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s2);
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
  }
  .plate__row dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    text-align: right;
  }
  .pinout {
    display: grid;
    gap: var(--s1);
    padding-top: var(--s2);
  }
  .pinout dl {
    margin: 0;
    border: 1px solid var(--line-strong);
  }
  .pinout div {
    display: flex;
    justify-content: space-between;
    gap: var(--s2);
    padding: 7px 10px;
    border-bottom: 1px dashed var(--line);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .pinout div:last-child {
    border-bottom: 0;
  }
  .pinout dt {
    font-weight: 700;
    color: var(--signal-ink);
  }
  .pinout dd {
    margin: 0;
    color: var(--ink-2);
    text-align: right;
  }
  .plate__shape {
    margin-top: auto;
    display: grid;
    gap: 6px;
    padding: var(--s2) 0;
  }
  .plate__shape code {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--signal-ink);
  }
  .plate__barcode {
    height: 32px;
    background: repeating-linear-gradient(
      90deg,
      var(--ink) 0 2px,
      transparent 2px 4px,
      var(--ink) 4px 5px,
      transparent 5px 9px,
      var(--ink) 9px 12px,
      transparent 12px 13px
    );
    opacity: 0.85;
  }

  @media (max-width: 1080px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .plate {
      max-width: 560px;
    }
  }
  @media (max-width: 480px) {
    .hero {
      padding-top: var(--s6);
    }
    .install__cmd {
      font-size: 0.75rem;
    }
  }
</style>
