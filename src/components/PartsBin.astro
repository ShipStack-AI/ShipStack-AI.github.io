---
import { excerpt, modules, npmUrl, repoUrl, STATUS_LABEL } from '../data/modules';
import CodeBlock from './CodeBlock.astro';
import SectionHead from './SectionHead.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const builtCount = modules.filter((m) => m.status === 'built').length;
---

<section class="section" id="parts" aria-labelledby="parts-title">
  <div class="wrap">
    <SectionHead no="01" kicker="The parts bin" title={`${modules.length} parts. ${builtCount} built so far.`} id="parts-title">
      Each part is one small MIT package with one job, a memory adapter for tests and one reference adapter for production.
      Parts still in progress are shown as they are: drawn, specified, not shipped.
    </SectionHead>

    <ul class="bin" role="list">
      {
        modules.map((m) => {
          const featured = m.status === 'built';
          return (
            <li class:list={['part', `part--${m.status}`, { 'part--featured': featured }]}>
              <div class="part__head">
                <span class="part__no">{m.part}</span>
                <span class:list={['chip', `chip--${m.status}`]}>{STATUS_LABEL[m.status]}</span>
              </div>
              <h3 class="part__name">
                <a href={`${base}/modules/${m.slug}/`} class="part__link">
                  {m.name}
                </a>
              </h3>
              <p class="part__purpose">{m.purpose}</p>
              <dl class="part__spec">
                <div>
                  <dt class="label">Ref. adapter</dt>
                  <dd>{m.referenceAdapter}</dd>
                </div>
                <div>
                  <dt class="label">Package</dt>
                  <dd>{m.pkg}</dd>
                </div>
              </dl>
              {featured && (
                <dl class="part__datasheet">
                  {m.spec.map(([k, v]) => (
                    <div>
                      <dt class="label">{k}</dt>
                      <dd>{v}</dd>
                    </div>
                  ))}
                </dl>
              )}
              {featured && m.snippet.kind === 'source' && (
                <CodeBlock
                  class="part__code"
                  code={excerpt(m)}
                  label={`examples/basic.ts · lines ${m.snippet.excerpt[0]}–${m.snippet.excerpt[1]}`}
                  note={`Source: ShipStack-AI/${m.repo}@${m.snippet.ref}, imports rewritten to package paths.`}
                />
              )}
              <div class="part__links">
                <a href={`${base}/modules/${m.slug}/`}>Datasheet</a>
                <a href={repoUrl(m)} rel="noopener">GitHub</a>
                {m.published ? (
                  <a href={npmUrl(m)} rel="noopener">npm</a>
                ) : (
                  <span class="part__nolink" title="Not published to npm yet">npm: not yet</span>
                )}
              </div>
            </li>
          );
        })
      }
      <li class="part part--slot">
        <div class="part__head">
          <span class="part__no">SS-··</span>
          <span class="label">Empty slot</span>
        </div>
        <h3 class="part__name">Your adapter</h3>
        <p class="part__purpose">
          Every adapter interface ships a conformance suite. Pass it and your adapter is a drop-in part.
        </p>
        <div class="part__links">
          <a href="https://github.com/ShipStack-AI/rate-limit#custom-stores" rel="noopener">How to write one</a>
        </div>
      </li>
    </ul>
  </div>
</section>

<style>
  .bin {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-flow: row dense;
    gap: var(--s2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .part {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s2);
    min-width: 0;
    padding: var(--s3);
    background: var(--paper);
    border: 1.5px solid var(--ink);
    transition:
      transform 180ms var(--ease),
      box-shadow 180ms var(--ease);
  }
  /* The hole punch of a hanging part label. */
  .part::before {
    content: '';
    position: absolute;
    top: 8px;
    right: 50%;
    width: 24px;
    height: 8px;
    margin-right: -12px;
    border: 1.5px solid var(--line-strong);
    border-radius: 4px;
  }
  .part:hover,
  .part:focus-within {
    transform: translateY(-4px);
    box-shadow: 0 4px 0 var(--shadow);
  }
  .part--in-progress {
    border-style: dashed;
    border-color: var(--ink-3);
    background: transparent;
  }
  .part--in-progress .part__name,
  .part--in-progress .part__no {
    color: var(--ink-2);
  }
  .part--featured {
    grid-column: span 2;
    grid-row: span 2;
    background: var(--paper);
    border-width: 2px;
    box-shadow: inset 0 6px 0 var(--signal);
  }
  .part--featured:hover,
  .part--featured:focus-within {
    box-shadow:
      inset 0 6px 0 var(--signal),
      0 4px 0 var(--shadow);
  }
  .part--slot {
    border: 1.5px dashed var(--line-strong);
    background: repeating-linear-gradient(-45deg, var(--grid-major) 0 1px, transparent 1px 8px);
  }
  .part__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s1);
    padding-bottom: var(--s1);
    border-bottom: 1px solid var(--line-strong);
  }
  .part__no {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
  }
  .part__name {
    font-size: 1.75rem;
    letter-spacing: -0.035em;
  }
  .part--featured .part__name {
    font-size: clamp(2.25rem, 4vw, 3.25rem);
  }
  .part__link {
    text-decoration: none;
  }
  .part__link::after {
    /* Whole card is the click target; links below stay above it. */
    content: '';
    position: absolute;
    inset: 0;
  }
  .part__purpose {
    color: var(--ink-2);
    font-size: 0.9375rem;
  }
  .part--featured .part__purpose {
    font-size: 1.125rem;
    max-width: 40ch;
  }
  .part__spec {
    display: grid;
    gap: var(--s1);
    margin: 0;
  }
  .part--featured .part__spec {
    grid-template-columns: 1fr 1fr;
  }
  .part__spec dd {
    margin: 2px 0 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
  }
  .part__datasheet {
    display: grid;
    margin: 0;
    border-top: 2px solid var(--ink);
  }
  .part__datasheet div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s2);
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
  }
  .part__datasheet dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    text-align: right;
  }
  .part__code {
    position: relative;
    z-index: 1;
  }
  /* Show the verbatim excerpt without a scrollbar: wrap long lines. */
  .part :global(.part__code pre) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .part__links {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 4px var(--s2);
    margin-top: auto;
    padding-top: var(--s1);
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .part__nolink {
    color: var(--ink-3);
  }

  @media (max-width: 1080px) {
    .bin {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .bin {
      grid-template-columns: minmax(0, 1fr);
    }
    .part--featured {
      grid-column: auto;
      grid-row: auto;
    }
    .part--featured .part__spec {
      grid-template-columns: 1fr;
    }
  }
</style>
