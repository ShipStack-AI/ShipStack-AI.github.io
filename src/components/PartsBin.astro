---
import { builtCount, commitUrl, excerpt, modules, npmUrl, repoUrl, shortRef, STATUS_LABEL } from '../data/modules';
import CodeBlock from './CodeBlock.astro';
import SectionHead from './SectionHead.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title =
  builtCount === modules.length ? `${modules.length} parts. All on the shelf.` : `${modules.length} parts. ${builtCount} built so far.`;
---

<section class="section" id="parts" aria-labelledby="parts-title">
  <div class="wrap">
    <SectionHead no="01" kicker="The parts bin" title={title} id="parts-title">
      Each part is one small MIT package with one job, a memory adapter for tests and one reference adapter for
      production. Every snippet below is that repo's real <code>examples/basic.ts</code>, pinned to a commit.
    </SectionHead>

    <ul class="bin" role="list">
      {
        modules.map((m) => (
          <li class:list={['part', `part--${m.status}`]} id={`part-${m.slug}`}>
            <div class="part__head">
              <span class="part__no">{m.part}</span>
              <span class="part__pkg">{m.pkg}</span>
              <span class:list={['chip', `chip--${m.status}`]}>{STATUS_LABEL[m.status]}</span>
            </div>
            <div class="part__body">
              <div class="part__info">
                <h3 class="part__name">
                  <a href={`${base}/modules/${m.slug}/`} class="part__link">
                    {m.name}
                  </a>
                </h3>
                <p class="part__purpose">{m.purpose}</p>
                <dl class="part__spec">
                  <div>
                    <dt class="label">Ref. adapter</dt>
                    <dd>{m.referenceAdapter}</dd>
                  </div>
                  {m.spec.slice(0, 2).map(([k, v]) => (
                    <div>
                      <dt class="label">{k}</dt>
                      <dd>{v}</dd>
                    </div>
                  ))}
                </dl>
              </div>
              <CodeBlock
                class="part__code"
                code={excerpt(m)}
                label={`basic.ts · L${m.excerpt[0]}–${m.excerpt[1]}`}
                note={m.note}
                wrap
              />
            </div>
            <div class="part__links">
              <a href={`${base}/modules/${m.slug}/`}>Datasheet</a>
              <a href={repoUrl(m)} rel="noopener">GitHub</a>
              <a href={commitUrl(m)} rel="noopener" class="mono">@{shortRef(m)}</a>
              {m.published ? (
                <a href={npmUrl(m)} rel="noopener">npm</a>
              ) : (
                <span class="part__nolink">Not on npm yet</span>
              )}
            </div>
          </li>
        ))
      }
    </ul>

    <div class="slot">
      <span class="part__no">SS-··</span>
      <p>
        <strong>Empty slot: your adapter.</strong> Every adapter interface ships a conformance suite at
        <code>/testing</code>. Pass it and your adapter is a drop-in part.
      </p>
      <a href="https://github.com/ShipStack-AI/rate-limit#custom-stores" rel="noopener">How to write one →</a>
    </div>
  </div>
</section>

<style>
  .bin {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .part {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--paper);
    border: 1.5px solid var(--ink);
    transition:
      transform 180ms var(--ease),
      box-shadow 180ms var(--ease);
  }
  .part:hover,
  .part:focus-within {
    transform: translateY(-4px);
    box-shadow: 0 4px 0 var(--shadow);
  }
  .part--in-progress {
    border-style: dashed;
    border-color: var(--ink-3);
  }
  .part__head {
    display: flex;
    align-items: center;
    gap: var(--s2);
    padding: 10px var(--s3);
    border-bottom: 1.5px solid var(--ink);
    background: var(--paper-2);
  }
  .part__no {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    padding: 2px 6px;
    background: var(--ink);
    color: var(--paper);
  }
  .part__pkg {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-3);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .part__body {
    display: grid;
    gap: var(--s3);
    flex: 1;
    align-content: start;
    padding: var(--s3);
  }
  .part__info {
    display: grid;
    gap: var(--s2);
  }
  .part__name {
    font-size: clamp(2rem, 3.4vw, 2.75rem);
    letter-spacing: -0.04em;
  }
  .part__link {
    text-decoration: none;
  }
  .part__purpose {
    max-width: 52ch;
    color: var(--ink-2);
  }
  .part__spec {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s2);
    margin: 0;
    padding-top: var(--s2);
    border-top: 1px solid var(--line);
  }
  .part__spec dd {
    margin: 2px 0 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
  }
  .part__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px var(--s3);
    padding: 12px var(--s3);
    border-top: 1px solid var(--line-strong);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .part__nolink {
    margin-left: auto;
    color: var(--ink-3);
  }
  .part :global(.part__code pre) {
    font-size: 0.75rem;
  }
  .slot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s2) var(--s3);
    margin-top: var(--s3);
    padding: var(--s3);
    border: 1.5px dashed var(--line-strong);
    background: repeating-linear-gradient(-45deg, var(--grid-major) 0 1px, transparent 1px 8px);
  }
  .slot .part__no {
    background: transparent;
    color: var(--ink-2);
    border: 1px dashed var(--ink-3);
  }
  .slot p {
    flex: 1 1 360px;
    color: var(--ink-2);
  }
  .slot strong {
    color: var(--ink);
  }
  .slot a {
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  @media (max-width: 1080px) {
    .bin {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .part__head,
    .part__body,
    .part__links {
      padding-inline: var(--s2);
    }
    .part__spec {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s1);
    }
    .part__pkg {
      display: none;
    }
    .part__head .chip {
      margin-left: auto;
    }
  }
</style>
