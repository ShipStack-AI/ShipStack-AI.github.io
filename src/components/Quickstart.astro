---
import Content from '../content/quickstart.mdx';
import { modules, shortRef } from '../data/modules';
import SectionHead from './SectionHead.astro';

const used = modules.filter((m) => m.slug === 'auth' || m.slug === 'rate-limit');
---

<section class="section" id="quickstart" aria-labelledby="quickstart-title">
  <div class="wrap qs">
    <SectionHead no="04" kicker="Quickstart" title="From empty Hono app to a guarded, throttled API." id="quickstart-title">
      Four steps, about thirty lines, two parts. Swap either memory store for Postgres or Redis later without touching the
      routes. Behind a proxy, key the limiter on a header your proxy sets and clients cannot spoof.
    </SectionHead>
    <div class="prose">
      <Content />
    </div>
    <aside class="qs__note">
      <span class="label label--ink">Checked, not assumed</span>
      <p>
        These exact steps were run against {used.map((m, i) => (<>{i > 0 && ' and '}<code>{m.name}@{shortRef(m)}</code></>))}
        with Hono's <code>app.request()</code>. Not on npm yet: until the first publish, install from the GitHub repos.
      </p>
    </aside>
  </div>
</section>

<style>
  .prose :global(.steps) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s4);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .prose :global(.steps > li) {
    counter-increment: step;
    display: flex;
    flex-direction: column;
    gap: var(--s2);
    min-width: 0;
    padding-top: var(--s2);
    border-top: 2px solid var(--ink);
  }
  .prose :global(.steps > li:first-child),
  .prose :global(.steps > li:last-child) {
    grid-column: 1 / -1;
  }
  .prose :global(h3) {
    display: flex;
    align-items: baseline;
    gap: var(--s2);
    font-size: 1.5rem;
    letter-spacing: -0.03em;
  }
  .prose :global(h3)::before {
    content: counter(step, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--signal-ink);
  }
  .prose :global(pre) {
    flex: 1;
    border: 1px solid var(--line-strong);
  }
  .qs__note {
    display: grid;
    gap: var(--s1);
    max-width: 720px;
    margin-top: var(--s5);
    padding: var(--s3);
    border: 1.5px dashed var(--ink-3);
  }
  .qs__note p {
    color: var(--ink-2);
  }
  @media (max-width: 1080px) {
    .prose :global(.steps) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
